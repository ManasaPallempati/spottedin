# Data source: "mock" (default — works with zero credentials) or "supabase".
# When unset, mock is used unless both Supabase vars below are present.
SPOTTED_DATA_MODE=mock
NEXT_PUBLIC_APP_URL=https://spottedin.co

# Supabase (Phase 1: optional; required only for SPOTTED_DATA_MODE=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe test mode (Phase 1 checkout scaffold; not wired in the skeleton)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Vercel cron authorization (set a long random value in production)
CRON_SECRET=
